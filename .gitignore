# Cache HTML mentah dan hasil scraping
data/raw_html/
data/articles.json
data/*.log
data/*.jsonl
data/quota_ledger.json
# Berkas kunci OS buku besar kuota (llm/ledger.file_lock); isinya kosong, yang mengunci adalah OS
data/*.lock
data/chroma/
data/candidates/
data/candidates_cache/

# Python
__pycache__/
*.py[cod]

# Rahasia
.env

# Virtual environment
.venv/
venv/
env/

# Setelan lokal Streamlit (mis. mode penguji demo); bisa berisi rahasia
.streamlit/secrets.toml

# Arsip indeks (salinan ChromaDB + articles.json, ~9 MB; berisi teks pihak ketiga dan berkas biner
# yang ditulis ulang ChromaDB setiap kali dibuka). Sidik jari isinya tercatat di testset/v1.meta.json.
archive/*
!archive/v1/
archive/v1/*
# Kecuali daftar artikel (metadata saja, tanpa isi seksi; aman dipublikasikan):
!archive/v1/article_ids.json
# README arsip dan artefak fitur yang dihapus dari kode (Tahap 1b)
!archive/README.md
!archive/fitur_mati/

# Hasil perluasan basis data (teks artikel pihak ketiga, termasuk kontak penipu)
data/expansion/

# Cadangan indeks produksi sebelum operasi berisiko (tidak di-commit; terpisah dari archive/v1)
data/backups/

# Keadaan container Docker (salinan indeks, buku besar kuota container, log, hasil alat)
data/container/

# Penanda pembaruan berkala (ditulis/dihapus otomatis oleh scraping.scheduled)
PERHATIAN_PEMBARUAN.txt

# Berkas acuan desain mockup (milik pemilik proyek; tidak di-commit, tidak dirujuk dokumen permanen)
docs/desain_tampilan/
