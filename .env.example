# Salin berkas ini menjadi .env (yang sudah di-gitignore) lalu isi nilainya.
# JANGAN commit .env dan jangan tempel kunci di chat/log.

# Penyedia LLM: saat ini hanya "gemini"
LLM_PROVIDER=gemini

# Kunci dari https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opsional. Bawaan: gemini-3.8-flash (Flash stabil terbaru, lihat CLAUDE.md)
# LLM_MODEL=gemini-3.8-flash

# Opsional. minimal | low | medium | high (bawaan: medium)
# LLM_THINKING_LEVEL=medium

# Opsional. Jeda minimum antar-panggilan dalam detik (bawaan: 4)
# LLM_MIN_INTERVAL_S=4
